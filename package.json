{
  "name": "env-branch-switcher",
  "displayName": "%displayName%",
  "description": "%description%",
  "version": "0.1.3",
  "publisher": "exeltarkus",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/exeldtarkus/env-branch-switcher.git"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "workspaceContains:.git"
  ],
  "extensionDependencies": [
    "vscode.git"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "envBranchSwitcher.activation",
        "title": "%command.activation%",
        "category": "Env Branch Switcher"
      },
      {
        "command": "envBranchSwitcher.language",
        "title": "%command.language%",
        "category": "Env Branch Switcher"
      },
      {
        "command": "envBranchSwitcher.saveSnapshot",
        "title": "%command.saveSnapshot%",
        "category": "Env Branch Switcher"
      },
      {
        "command": "envBranchSwitcher.openSnapshotsFolder",
        "title": "%command.openSnapshotsFolder%",
        "category": "Env Branch Switcher"
      },
      {
        "command": "envBranchSwitcher.reset",
        "title": "%command.reset%",
        "category": "Env Branch Switcher"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "envBranchSwitcher.saveSnapshot",
          "when": "config.envBranchSwitcher.enabled"
        },
        {
          "command": "envBranchSwitcher.openSnapshotsFolder",
          "when": "config.envBranchSwitcher.enabled"
        },
        {
          "command": "envBranchSwitcher.reset",
          "when": "config.envBranchSwitcher.enabled"
        }
      ]
    },
    "configuration": {
      "title": "Env Branch Switcher",
      "properties": {
        "envBranchSwitcher.enabled": {
          "type": "boolean",
          "default": false,
          "description": "%config.enabled%"
        },
        "envBranchSwitcher.envFile": {
          "type": "string",
          "default": ".env",
          "description": "%config.envFile%"
        },
        "envBranchSwitcher.exclude": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            ".git",
            ".env-branches",
            "node_modules",
            "target",
            "build",
            "bin",
            "out",
            "dist",
            "vendor",
            ".gradle",
            ".idea",
            ".venv",
            "venv",
            "__pycache__"
          ],
          "description": "%config.exclude%"
        },
        "envBranchSwitcher.language": {
          "type": "string",
          "enum": [
            "auto",
            "en",
            "id"
          ],
          "default": "auto",
          "enumDescriptions": [
            "%config.language.auto%",
            "%config.language.en%",
            "%config.language.id%"
          ],
          "description": "%config.language%"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "test": "npm run compile && node --test out/test/*.test.js",
    "package": "vsce package --skip-license",
    "install:local": "node scripts/install-local.js"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^4.0.0",
    "typescript": "^5.4.0"
  }
}
